# Prettier reads this file too: since Prettier 3, --ignore-path defaults to
# .gitignore as well as .prettierignore, so this is the single ignore list
# for both git and `prettier --check .`. There is no separate .prettierignore.

# Secrets — never commit these (*.pem includes the key Chrome generates
# when packing an extension into a .crx)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# Packaged builds (Chrome Web Store upload zip, packed extension)
*.zip
*.crx

# Logs
*.log

# Editors
.vscode/
.idea/
*.swp
*~

# Claude Code per-user local files (shared .claude/settings.json is fine)
.claude/settings.local.json
CLAUDE.local.md

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Local audit working notes (not part of the extension)
tests/FINDINGS.md
tests/VERIFY.md
tests/LOG.md
